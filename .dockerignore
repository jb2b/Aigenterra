# Allow only the API build inputs; local captures and unknown future folders stay out.
**
!Directory.Build.props
!global.json
!src/Aigenterra.Api/**/*.cs
!src/Aigenterra.Api/Aigenterra.Api.csproj
!src/Aigenterra.Api/appsettings.json
!src/Aigenterra.Application/**/*.cs
!src/Aigenterra.Application/Aigenterra.Application.csproj
!src/Aigenterra.Domain/**/*.cs
!src/Aigenterra.Domain/Aigenterra.Domain.csproj
!src/Aigenterra.Infrastructure/**/*.cs
!src/Aigenterra.Infrastructure/Aigenterra.Infrastructure.csproj
!src/Aigenterra.Adapters.Codex/**/*.cs
!src/Aigenterra.Adapters.Codex/Aigenterra.Adapters.Codex.csproj
!src/Aigenterra.ServiceDefaults/**/*.cs
!src/Aigenterra.ServiceDefaults/Aigenterra.ServiceDefaults.csproj
**/bin
**/obj
**/.git
**/.codex
**/.env*
**/secrets*
**/node_modules
**/TestResults
**/test-results
**/artifacts
**/evidence
**/CodexScope*
**/logs
**/*.log
**/.vs
**/.vscode
**/.idea
